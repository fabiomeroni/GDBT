      <Lemme>
        <ReprésentationDeForme langue="num">ɣil</ReprésentationDeForme>
        <ReprésentationDeForme langue="drg">βrɪɣɪl</ReprésentationDeForme>
        <ReprésentationDeForme langue="kro">rɔŋ</ReprésentationDeForme>
        <ReprésentationDeForme langue="olr">rɔŋ</ReprésentationDeForme>
        <ReprésentationDeForme langue="lkn">rɔŋ</ReprésentationDeForme>
      </Lemme>
      <ClasseGrammaticale>v.tr.</ClasseGrammaticale>
      <DomaineSémantique>Cognition</DomaineSémantique>
      <Sens identifiant="knowⓢ1">
        <NuméroDeSens>1</NuméroDeSens>
        <Glose langue="eng">know, be familiar with</Glose>
        <gloss>know</gloss>
        <Définition>
          <ReprésentationDeTexte langue="eng">know, be familiar with</ReprésentationDeTexte>
        </Définition>
        <Notes>
          <ReprésentationDeTexte langue="eng">Transitive verb of knowledge. The eastern languages (Nume, Dorig) retain fuller forms with more syllables, while central and western varieties show convergence on a monosyllabic root.</ReprésentationDeTexte>
        </Notes>
      </Sens>
