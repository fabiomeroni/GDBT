    <EntréeLexicale identifiant="nondum1">
      <Lemme>
        <ReprésentationDeForme langue="num">βitis</ReprésentationDeForme>
        <ReprésentationDeForme langue="drg">sɔwsɛ</ReprésentationDeForme>
        <ReprésentationDeForme langue="kro">tɪ</ReprésentationDeForme>
        <ReprésentationDeForme langue="olr">tɪ</ReprésentationDeForme>
        <ReprésentationDeForme langue="lkn">atɪ</ReprésentationDeForme>
      </Lemme>
      <ClasseGrammaticale>part.</ClasseGrammaticale>
