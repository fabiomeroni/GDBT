      <Sens identifiant="nondum1ⓢ1">
        <NuméroDeSens>1</NuméroDeSens>
        <Glose langue="eng">NONDUM₁ — pre-verbal negator ('not yet')</Glose>
        <gloss>NONDUM₁</gloss>
        <Définition>
          <ReprésentationDeTexte langue="eng">NONDUM₁ — pre-verbal negator &lt;em&gt;('not yet')&lt;/em&gt;</ReprésentationDeTexte>
        </Définition>
        <Notes>
          <ReprésentationDeTexte langue="eng">The pre-verbal component of the discontinuous negation construction. Occupies the position immediately before the subject–verb complex. Forms diverge across the chain: Dorig retains an older bisyllabic shape, while central and western varieties show reduction.</ReprésentationDeTexte>
        </Notes>
        <RelationSémantique>
          <Type>renvoi</Type>
          <Cible cible="nondum2">NONDUM₂</Cible>
          <GloseRelation langue="eng">post-verbal counterpart</GloseRelation>
        </RelationSémantique>
      </Sens>
    </EntréeLexicale>

