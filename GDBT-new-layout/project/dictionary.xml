          <Type>renvoi</Type>
          <Cible cible="nondum1">NONDUM₁</Cible>
          <GloseRelation langue="eng">pre-verbal counterpart</GloseRelation>
        </RelationSémantique>
      </Sens>
    </EntréeLexicale>

